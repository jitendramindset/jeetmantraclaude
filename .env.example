# EduOS / JeetMantra — environment template.
# Copy to .env.production (or .env.qa / .env.development) and fill real values.
# NEVER commit the filled file — only this .example. (.gitignore covers .env*.)

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public origin(s) the browser uses — locks CORS. Comma-separated for multiple.
FRONTEND_URL=https://app.example.com
PUBLIC_BASE_URL=https://app.example.com      # used by sitemap/SEO absolute URLs

# ── Supabase (self-hosted) ──────────────────────────────────────────────────
SUPABASE_URL=https://api.example.cloud
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__   # server-only; never expose
SUPABASE_ANON_KEY=__anon_key__

# ── Auth / crypto ───────────────────────────────────────────────────────────
JWT_SECRET=__long_random_string__
DASHBOARD_PASSWORD=__admin_dashboard_pw__

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=__rzp_key_id__
RAZORPAY_KEY_SECRET=__rzp_key_secret__
RAZORPAY_WEBHOOK_SECRET=__rzp_webhook_secret__
PLATFORM_COMMISSION_RATE=15

# ── Google OAuth (Sign In With Google / One Tap) ────────────────────────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0.
# Add your domain to "Authorised JavaScript origins" (e.g. https://app.example.com).
GOOGLE_CLIENT_ID=__your_google_oauth_client_id__

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
FCM_SERVER_KEY=__fcm_server_key__

# ── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_BUSINESS_TOKEN=__whatsapp_api_token__
WHATSAPP_PHONE_ID=__whatsapp_phone_number_id__

# ── SendGrid (alternative to SMTP for transactional email) ──────────────────
SENDGRID_API_KEY=__sendgrid_api_key__
SENDGRID_FROM=noreply@example.com

# ── AI / OpenAI (vector search + RAG) ───────────────────────────────────────
OPENAI_API_KEY=__openai_api_key__

# ── Integrations ────────────────────────────────────────────────────────────
N8N_SECRET=__shared_secret_for_n8n_sync__        # fail-closed in production
# AI generation endpoint (also settable per-org via the central settings page)
AI_WEBHOOK_URL=
AI_WEBHOOK_KEY=

# ── Rate limiting (requests / minute) ───────────────────────────────────────
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_STRICT=20

# ── Cache ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Email (SMTP) — Gmail example ────────────────────────────────────────────
# For Gmail: enable 2FA, then create an "App Password" (Google Account →
# Security → App passwords) and use it as SMTP_PASS (NOT your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mantravat@gmail.com
SMTP_PASS=__gmail_app_password__
SMTP_FROM=JeetMantra <mantravat@gmail.com>

# ── SMS / OTP delivery (pick ONE; else OTP logs to console in dev) ───────────
# Option A — generic webhook (great with n8n → your SMS gateway):
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
# Option B — Twilio:
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1xxxxxxxxxx

# ── Deployment (compose / Traefik / n8n) ────────────────────────────────────
APP_DOMAIN=app.example.com
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=admin@example.com
N8N_USER=admin
N8N_PASSWORD=__strong_n8n_password__
# Image the prod compose + Watchtower pull (override the default if forked):
API_IMAGE=ghcr.io/jitendramindset/jeetmantraclaude:latest

# ── Backup (only needed with `--profile backup`) ────────────────────────────
# 32-character key to AES-256-CBC encrypt backup files before saving/uploading.
# Decode later: openssl enc -d -aes-256-cbc -in backup.json.gz.enc -out backup.json.gz
BACKUP_ENCRYPT_KEY=__32_char_random_key__
# Optional S3-compatible upload (requires awscli in the backup container):
BACKUP_S3_BUCKET=s3://my-bucket/jeetmantra-backups
BACKUP_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Monitoring (only needed with `--profile monitoring`) ────────────────────
GRAFANA_DOMAIN=grafana.example.com
UPTIME_DOMAIN=status.example.com
GRAFANA_PASSWORD=__strong_grafana_admin_pw__
# Sentry (error monitoring) — paste your project DSN; app reads it if wired:
SENTRY_DSN=

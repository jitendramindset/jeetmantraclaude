# EduOS E2E environment — copy to e2e/.env and fill in as needed.
# These are read by your shell / CI runner. Playwright does not auto-load .env
# unless you wire dotenv into playwright.config.js.

# Base URL of the running EduOS server (Express serves public/ + /api/*).
# Default if unset: http://localhost:5000
E2E_BASE_URL=http://localhost:5000

# Set to any non-empty value to ENABLE real-credential specs (loginViaApi).
# Leave unset/empty to skip them (e.g. on CI without a seeded DB).
# E2E_REAL_CREDS=1

# Real seeded credentials, per role. Only needed when E2E_REAL_CREDS is set.
# Backend: POST /api/auth/login {email,password} -> {token, user}
# E2E_STUDENT_EMAIL=student@example.com
# E2E_STUDENT_PASS=
# E2E_TEACHER_EMAIL=teacher@example.com
# E2E_TEACHER_PASS=
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASS=
# E2E_PARENT_EMAIL=parent@example.com
# E2E_PARENT_PASS=

# Multi-institute scoping: some endpoints honor an X-Active-Institution header.
# E2E_ACTIVE_INSTITUTION=

# CI is set automatically by most CI providers; when truthy, retries=1 and
# forbidOnly=true. Usually you do NOT set this locally.
# CI=1

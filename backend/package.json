{
  "name": "jeetmantra-backend",
  "version": "2.0.0",
  "description": "JeetMantra Backend API - All Roles, Marketplace, LevelDB, n8n, Vector Search",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --forceExit --coverage",
    "test:e2e": "node scripts/test-e2e.js",
    "test:smoke": "node ../test/smoke.js",
    "migrate": "bash ../scripts/deploy-p0.sh",
    "seed": "node scripts/seed.js",
    "lint": "eslint routes/ middleware/ utils/ --ext .js --max-warnings 0",
    "mcp": "node mcp-server.mjs",
    "mcp:http": "node mcp-server.mjs --http 5055"
  },
  "keywords": [
    "jeetmantra",
    "learning",
    "api",
    "supabase",
    "marketplace",
    "n8n"
  ],
  "author": "JeetMantra Team",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sentry/node": "^8.55.2",
    "@supabase/supabase-js": "^2.26.0",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "classic-level": "^1.3.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.2.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.11",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "supertest": "^6.3.4"
  }
}

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
JWT_SECRET=generate-with-openssl-rand-base64-64
SECRET_KEY_BASE=generate-with-openssl-rand-base64-64

# PostgreSQL Direct Connection (primary DB — used by all routes via pg.Pool)
# Self-hosted Supabase: postgresql://postgres:[POSTGRES_PASSWORD]@127.0.0.1:5432/postgres
# Supabase cloud:       postgresql://postgres:[POSTGRES_PASSWORD]@db.your-project.supabase.co:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your-postgres-password-here@127.0.0.1:5432/postgres
POSTGRES_PASSWORD=your-postgres-password-here
DASHBOARD_PASSWORD=your-dashboard-password-here

# Logflare Configuration
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-logflare-public-token-here
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-logflare-private-token-here

# S3 / Storage Configuration
S3_PROTOCOL_ACCESS_KEY_ID=your-s3-access-key-id-here
S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-access-key-secret-here

# Vault / Encryption Configuration
VAULT_ENC_KEY=generate-with-openssl-rand-hex-16
PG_META_CRYPTO_KEY=generate-with-openssl-rand-base64-32

# ── Additional Production Variables ──────────────────────────
# CORS
FRONTEND_URL=https://yourdomain.com

# Rate Limiting / Security
ADMIN_TOKEN=generate-with-openssl-rand-hex-32
METRICS_SECRET=generate-with-openssl-rand-hex-32
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Payment Gateways
RAZORPAY_KEY_ID=rzp_live_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
INSTAMOJO_API_KEY=your-instamojo-api-key
INSTAMOJO_AUTH_TOKEN=your-instamojo-auth-token

# AI / RAG
OPENAI_API_KEY=sk-your-openai-key

# Email (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=JeetMantra <noreply@yourdomain.com>

# S3 / Object Storage
S3_ENDPOINT=https://your-s3-endpoint
S3_BUCKET=jeetmantra-uploads
S3_REGION=ap-south-1

# n8n Webhook
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook

# Database Connection Pooling
# Use port 6543 (pgBouncer pooler) instead of 5432 for production load.
# Supabase provides this automatically — just change the port in the connection string.
# SUPABASE_DB_URL=postgresql://postgres:[POSTGRES_PASSWORD]@db.your-project.supabase.co:6543/postgres

# Misc
ALLOW_DEV_USERS=false
PORT=5000
NODE_ENV=production